// Waybar custom/todokase module — merge into ~/.config/waybar/config
//
// Add "custom/todokase" into your modules-right array, then:

"custom/todokase": {
  "exec": "todokase-waybar",
  "interval": 30,
  "return-type": "json",
  "on-click": "alacritty --class todokase -e todokase",
  "tooltip": true
}
