{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability — allows the webview to invoke Rust commands, open shell URLs, read the Omarchy theme dir, and read/write the todarchy store.",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:webview:default",
    "shell:allow-open",
    "notification:default",
    "dialog:default",
    "fs:default",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/.config/omarchy/**" },
        { "path": "$HOME/.local/share/todarchy/**" },
        { "path": "$HOME/.config/todarchy/**" }
      ]
    }
  ]
}
